# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment names you created in the Azure OpenAI resource:
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# --- Azure Cosmos DB ---
COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE=techweek

# --- Ingest trigger (used by the Azure Functions timer) ---
# Public URL of the deployed Next app, e.g. https://ms-hack.azurewebsites.net
INGEST_TARGET_URL=http://localhost:3000
